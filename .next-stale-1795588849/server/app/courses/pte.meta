{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/courses/layout,_N_T_/courses/[slug]/layout,_N_T_/courses/[slug]/page,_N_T_/courses/pte"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/courses/$d$slug/__PAGE__",
    "/courses/$d$slug",
    "/courses",
    "/_index",
    "/_head"
  ]
}
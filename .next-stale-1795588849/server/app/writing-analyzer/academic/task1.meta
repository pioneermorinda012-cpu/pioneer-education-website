{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/writing-analyzer/layout,_N_T_/writing-analyzer/academic/layout,_N_T_/writing-analyzer/academic/task1/layout,_N_T_/writing-analyzer/academic/task1/page,_N_T_/writing-analyzer/academic/task1"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/writing-analyzer/academic/task1/__PAGE__",
    "/writing-analyzer/academic/task1",
    "/writing-analyzer/academic",
    "/writing-analyzer",
    "/_index",
    "/_head"
  ]
}
{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/writing-analyzer/layout,_N_T_/writing-analyzer/gt/layout,_N_T_/writing-analyzer/gt/task2/layout,_N_T_/writing-analyzer/gt/task2/page,_N_T_/writing-analyzer/gt/task2"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/writing-analyzer/gt/task2/__PAGE__",
    "/writing-analyzer/gt/task2",
    "/writing-analyzer/gt",
    "/writing-analyzer",
    "/_index",
    "/_head"
  ]
}
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# practice media: the audio is ~110 MB and is served from Supabase Storage,
# but the reading and listening diagrams are small and must ship with the site
/public/practice/media/**/*.mp3
/public/practice/media/**/*.m4a
/public/practice/media/**/*.wav

# working folders, not part of the site
/_to_delete/
/Claude outputs/

# audio waiting to be processed by "npm run add-audio"
/new-audio/*
!/new-audio/README.txt

# papers waiting to be installed by "npm run add-test"
/new-tests/*
!/new-tests/README.txt

# staging copy of the recordings for manual upload to Supabase
/supabase-upload/
